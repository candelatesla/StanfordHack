# --- required for live mode (app runs in rules-only text mode without them) ---
ELEVENLABS_API_KEY=
NEBIUS_API_KEY=

# --- optional; leave blank for defaults. Run `python tools/check_keys.py` to pick models ---
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# small fast model for trigger/extraction
FAST_MODEL=
# larger model for answer cards + summary
SMART_MODEL=
# embedding model (blank = auto-pick from /v1/models)
EMBED_MODEL=
# realtime | batch  (realtime auto-falls back to batch)
STT_MODE=realtime
# ElevenLabs voice for the demo customer
TTS_VOICE_ID=
